<?xml version="1.0" encoding="utf-8"?>
<!--
	Compose sample. The Application is the library's generic BoxAndroidApplication; the
	Compose track uses a thin Kotlin host activity (MainActivity) that renders a
	BoxLang-authored UI tree via the library's Compose renderer.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

	<application
		android:name="ortus.boxlang.runtime.android.BoxAndroidApplication"
		android:label="BoxLang Compose Sample"
		android:theme="@android:style/Theme.Material.Light.NoActionBar">

		<activity
			android:name=".MainActivity"
			android:exported="true">
			<intent-filter>
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.LAUNCHER" />
			</intent-filter>
		</activity>

	</application>

</manifest>
