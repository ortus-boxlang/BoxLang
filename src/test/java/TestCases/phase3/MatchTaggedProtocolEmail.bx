@patternMatch( "Email", "canonical" )
class accessors=true {

	property canonical;
	property address;

	boolean function $matchPredicate( required struct patternDescriptor ) {
		return patternDescriptor.label == "Email";
	}

	struct function $matchBindings( required struct patternDescriptor ) {
		return {
			addr: this.getAddress()
		};
	}

}