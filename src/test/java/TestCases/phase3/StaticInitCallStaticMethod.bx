class {
	static {
		someStruct = { 
				foo : someStaticFunction( 'bar' )
		}
	}

	// Call static method from pseudo-constructor (without static. prefix)
	variables.fromPseudo = someStaticFunction( 'baz' );

	function getFromPseudo() {
		return variables.fromPseudo;
	}

	private static string function someStaticFunction( required string baz ) {
		return arguments.baz;
	}

}