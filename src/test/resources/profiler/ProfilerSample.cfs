// --- Plain statements, one per line
i = 0;
j = 0;

sleep( 2000 )

// --- A loop that runs
while( i < 3 ) {
    i++;
}

// --- A function declared and invoked
function doubleIt( n ) {
    return n * 2;
}
doubled = doubleIt( 21 );

// --- A function declared but NEVER invoked (body stays missed)
function neverCalled() {
    z = 1;
}

// --- A conditional branch — only one side runs
if( doubled > 40 ) {
    j = 1;
} else {
    j = 2;
}

if( true ) now(); else now();

if( true ) { now(); } else { now(); }


// --- more than one if-else in a row
if( false ) {
    now()
} else if( 1 == 2 ) {
    now()
} else if( 4 > 3 ) {
    now()
} else {
    now()
}

// --- more than one if-else in a row, take two
if( false ) {
    now()
} else if( 1 == 2 ) {
    now()
} else if( 4 < 3 ) {
    now()
} else {
    now()
}

// --- A ternary
k = j == 1 ? "big" : "small";

// --- A closure that IS invoked
adder = ( x ) => x + 100;
added = adder( doubled );

// --- A closure declared but NEVER invoked (body stays missed)
sleeper = ( x ) => {
    x = x + 1;
};
neverRan = 1;

// --- A simple switch — only the matching case runs
x = 2;
switch( x ) {
    case 1: a = 10; break;
    case 2: a = 20; break;
    default: a = 30;
}

// --- A try/catch/finally — only try and finally run
try {
    b = 1;
} catch( any e ) {
    c = 2;
} finally {
    d = 3;
}
// --- A try/catch/finally — all three bodies run
try {
    1/0;
    now()
    1+1
} catch( any e ) {
    c = 2;
} finally {
    d = 3;
}

// --- A for-in loop
arr = [ 10, 20, 30 ];
for( item in arr ) {
    x = item;
}

// --- A do-while loop
i = 0;
do {
    i++;
} while( i < 2 );

// --- A C-style for loop
j = 0;
for( i = 0; i < 3; i++ ) {
    j = j + i;
}

// --- Short-circuit: right side never runs
a = false;
b = 1;
x = a && b;
y = ( false || ( true || false ) ) || ( false && true )

// --- Elvis: right side runs when left is null
foo = null;
bar = 2;
x = foo ?: ( bar = 99 );

// --- Elvis: right side doesn't run
foo = "brad";
bar = 2;
x = foo ?: ( bar = 99 );


// --- Array + struct literals
arr2 = [ 10, 20, 30 ];
st = { one: 1, two: 2 };

// --- Array + struct literals multi-line
arr2 = [
    10,
    20,
    30
];
st = {
    one: 1,
    two: 2
};

// --- param: default is set when the variable is missing ... (complex default,
// compiled to a deferred closure — its span shows GREEN when run, RED when skipped)
param name="paramMissing" default=( now() );
// ... and is a no-op (default skipped — RED) when the variable already exists.
paramMissing = 1;
param name="paramMissing" default=( now() );

// --- param with the shorthand syntax: name=default
param paramShorthand=( now() );

// --- param with a LITERAL default stays fused inline (always covered)
param name="paramLiteral" default="bar";

// --- DISK class interactions (ProfilerComplexCF.cfc on disk, CFSCRIPT form)
// INSTANTIATED class: static block + pseudo-constructor run; members only on
// call. The `other` property default is APPLIED at instantiation (USED → GREEN);
// the `threshold` default is SKIPPED (ProfilerSuper presets it → RED).
diskInst = new src.test.resources.profiler.ProfilerComplexCF();
diskVal = diskInst.member( 5 );

// STATIC-ONLY class: class loads and its static init runs, but no instance is
// created — its COMPLEX property default is NEVER evaluated (NOT used → RED).
diskStatic = src.test.resources.profiler.ProfilerStaticOnlyCF::staticInitRan;

// --- DISK class interactions (ProfilerComplexCF.cfc on disk, CFSCRIPT form)
// INSTANTIATED class: static block + pseudo-constructor run; members only on
// call. The `other` property default is APPLIED at instantiation (USED → GREEN);
// the `threshold` default is SKIPPED (ProfilerSuper presets it → RED).
diskInstTag = new src.test.resources.profiler.ProfilerComplexTag();
diskVal = diskInstTag.member( 5 );

// STATIC-ONLY class: class loads and its static init runs, but no instance is
// created — its COMPLEX property default is NEVER evaluated (NOT used → RED).
result = src.test.resources.profiler.ProfilerStaticOnlyTag::staticMethod();
foo = src.test.resources.profiler.ProfilerStaticOnlyTag::myStaticVar;

// --- INTERFACE interactions ---
// Statically reference the CFC interface (loads it, runs NO bodies) and run
// the inherited DEFAULT method on the implementing class instance (GREEN).
cfIfaceInited = src.test.resources.profiler.ProfilerInterfaceCF::display;
cfImplGreeted = diskInst.greet();
// Same for the TAG interface (via its implementing class's default method).
tagImplGreeted = diskInstTag.greet();

