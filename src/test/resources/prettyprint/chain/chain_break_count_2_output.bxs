// Single call - should stay on one line
result = obj.foo();

// 2 calls - should break with break_count=2
result = obj
	.foo()
	.bar();

// 3 calls - should definitely break
result = obj
	.foo()
	.bar()
	.baz();

// Keep the initial receiver path on the assignment line
result = variables.productions
	.forUser( user )
	.get();

// Keep only the configured number of receiver accesses
result = variables.services
	.productions
	.forUser( user )
	.get();
